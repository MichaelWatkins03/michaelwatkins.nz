    <script>
        // Tailwind script
        function initializeTailwind() {
            document.documentElement.style.setProperty('--accent', '#6366f1');
        }
        
        // Mobile menu
        const mobileBtn = document.getElementById('mobile-menu-btn');
        mobileBtn.addEventListener('click', () => {
            const nav = document.createElement('div');
            nav.className = `fixed inset-0 bg-zinc-950 z-[100] p-8 flex flex-col`;
            nav.innerHTML = `
                <div class="flex justify-between items-center mb-12">
                    <div class="flex items-center gap-x-3">
                        <div class="w-9 h-9 bg-white rounded-2xl flex items-center justify-center">
                            <span class="text-zinc-950 font-bold text-2xl tracking-tighter">KL</span>
                        </div>
                        <span class="font-semibold text-xl">Kai Lennox</span>
                    </div>
                    <button class="text-4xl text-zinc-400">×</button>
                </div>
                <div class="flex flex-col gap-y-6 text-2xl font-medium">
                    <a href="#work" class="py-2">Work</a>
                    <a href="#approach" class="py-2">Approach</a>
                    <a href="#journal" class="py-2">Journal</a>
                </div>
                <div class="mt-auto pt-8">
                    <button onclick="document.getElementById('contact-modal').showModal(); this.closest('.fixed').remove()" 
                            class="w-full py-4 border border-white/30 rounded-3xl text-lg">Book a call</button>
                </div>
            `;
            document.body.appendChild(nav);
            
            nav.querySelector('button').onclick = () => nav.remove();
            nav.querySelectorAll('a').forEach(link => {
                link.onclick = () => {
                    nav.remove();
                    const target = document.querySelector(link.getAttribute('href'));
                    if (target) target.scrollIntoView({ behavior: 'smooth' });
                };
            });
        });

        // Project data
        const projects = [
            {
                title: "Lumina OS",
                subtitle: "Reimagining the desktop for deep work • 2025",
                role: "Lead Product Designer & Engineer",
                description: "Lumina is a spatial operating system designed from the ground up to reduce cognitive load. I led the entire product experience — from early research and interaction design to building the production interface in code.",
                impact: "Users report 40% longer focus sessions and significantly lower mental fatigue. The project has been featured in multiple design publications and is currently used by teams at several top tech companies.",
                tags: ["Product Design", "Motion", "Spatial Computing"]
            },
            {
                title: "Pulse",
                subtitle: "Wellness platform for high performers • 2024",
                role: "Design Systems Lead",
                description: "Pulse helps founders and executives manage energy instead of just tracking metrics. I created a complete design system and component library that made the product feel calm, premium, and deeply human.",
                impact: "The design system reduced design-to-dev handoff time by 65%. Pulse raised a $12M Series A shortly after launch.",
                tags: ["Design Systems", "Wellness", "Health Tech"]
            },
            {
                title: "Arc Studio",
                subtitle: "Design system for fast-moving startups • 2025",
                role: "Founder & Principal Designer",
                description: "Arc Studio is a living design system + component library built specifically for early-stage teams that need to ship fast without sacrificing quality or consistency.",
                impact: "Teams using Arc report shipping beautiful interfaces 3× faster while maintaining design coherence across products.",
                tags: ["Design Systems", "Developer Experience", "Startups"]
            }
        ];

        let currentProjectIndex = 0;

        function showProjectModal(index) {
            currentProjectIndex = index;
            const project = projects[index];
            const modal = document.getElementById('project-modal');
            const header = document.getElementById('modal-header');
            const content = document.getElementById('modal-content');
            
            header.innerHTML = `
                <div>
                    <div class="font-semibold text-3xl tracking-tight">${project.title}</div>
                    <div class="text-zinc-400 mt-1">${project.subtitle}</div>
                    <div class="text-sm text-indigo-400 mt-2">${project.role}</div>
                </div>
            `;
            
            content.innerHTML = `
                <div class="space-y-8">
                    <div>
                        <h4 class="font-semibold text-sm tracking-widest text-zinc-400 mb-3">THE CHALLENGE</h4>
                        <p class="text-zinc-300">${project.description}</p>
                    </div>
                    
                    <div>
                        <h4 class="font-semibold text-sm tracking-widest text-zinc-400 mb-3">IMPACT</h4>
                        <p class="text-zinc-300">${project.impact}</p>
                    </div>
                    
                    <div>
                        <h4 class="font-semibold text-sm tracking-widest text-zinc-400 mb-3">MY ROLE</h4>
                        <div class="flex flex-wrap gap-2">
                            ${project.tags.map(tag => 
                                `<span class="px-4 py-1 text-xs bg-white/5 border border-white/10 rounded-2xl">${tag}</span>`
                            ).join('')}
                        </div>
                    </div>
                </div>
            `;
            
            modal.showModal();
